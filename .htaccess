Options -Indexes
RewriteEngine On

# Route API and health checks to the PHP front controller.
RewriteRule ^health/?$ api/index.php [QSA,L]
RewriteRule ^api/v1(?:/.*)?$ api/index.php [QSA,L]

# Prevent accidental access to private or repository metadata files.
<FilesMatch "(^\.env|^\.git|\.sql$|\.log$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
